<?xml version="1.0" encoding="utf-8"?>
<!--
  Logo TermX: huruf X yang tersusun dari dua chevron prompt — ">" bergradien hijau-sian dan "<"
  putih — ditambah kursor "_" di kanan bawah. Semua isi berada dalam zona aman ikon adaptif (66dp).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- bayangan glow -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#333DDC97"
        android:strokeWidth="17"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M34,33 L54,53 L34,73" />
    <!-- chevron ">" -->
    <path
        android:fillColor="#00000000"
        android:strokeWidth="10"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M34,33 L54,53 L34,73">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="34" android:startY="33"
                android:endX="54" android:endY="73">
                <item android:offset="0" android:color="#FF22D3EE" />
                <item android:offset="1" android:color="#FF3DDC97" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- chevron "<" -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFE6EDF3"
        android:strokeWidth="10"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M74,33 L54,53 L74,73" />
    <!-- kursor -->
    <path
        android:fillColor="#FF3DDC97"
        android:pathData="M63,79h14a2.25,2.25 0,0 1,0 4.5h-14a2.25,2.25 0,0 1,0 -4.5z" />
</vector>
